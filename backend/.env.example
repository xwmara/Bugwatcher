# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon: Dashboard > Connect, branch "dev")
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SSL is required by Neon. Set to false only for a local database without SSL.
DB_SSL=true

# Long random string used to sign login tokens (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port for the API server
PORT=3000

# Frontend URL allowed by CORS
CLIENT_URL=http://localhost:5173

# Password for the demo accounts created by "npm run db:seed" (demo-manager@example.com, ...).
# Pick your own; it is only needed when seeding.
DEMO_PASSWORD=choose-a-demo-password

# Number of proxies in front of the app when deployed (0 locally). See render.yaml.
TRUST_PROXY=0
